+# octosense-octoscode-service — D9 spike, shape (ii).
+#
+# The `octoscode` host service: the Rust half of a CONTAINED script app. It
+# owns the octos client (AppCard's `octos-app-transport` / `-store`) and
+# answers two requests from the bundle's Splash script:
+#
+#   octoscode.session_open  -> { session_id }
+#   octoscode.session_list  -> { count }
+#
+# Throwaway spike: nothing here lands in OctoSense.
+[package]
+name = "octosense-octoscode-service"
+version = "0.1.0"
+edition = "2021"
+license = "Apache-2.0"
+publish = false
+
+[dependencies]
+# The same App Hub rev as Mail/News/llm: one appstore, one service registry.
+octosense-appstore = { workspace = true }
+# The same octos client crates AppCard uses, reused from a host service.
+octos-app-store = { workspace = true }
+octos-app-transport = { workspace = true }
+octos-core = { workspace = true }
+tokio = { workspace = true, features = ["rt-multi-thread"] }
+serde_json = { workspace = true }
+url = { workspace = true }
+log = { workspace = true }
diff --git a/apps/octoscode/host-service/src/lib.rs b/apps/octoscode/host-service/src/lib.rs
new file mode 100644
index 0000000..b2a0602
--- /dev/null
+++ b/apps/octoscode/host-service/src/lib.rs
@@ -0,0 +1,256 @@
+//! octosense-octoscode-service — D9 spike, shape (ii): the RustHOST SERVICE
+//! behind a contained OctoScript app.
+//!
+//! The bundle's script (`apps/octoscode/bundle/main.splash`) calls
+//! `host.request("octoscode.session_open", …)` and
+//! `host.request("octoscode.session_list", …)`. This service owns the octos
+//! client — AppCard's `octos-app-transport` / `octos-app-store`, the same
+//! crates shape (i) used in-process — and answers those two requests.
+//!
+//! What this proves about the SHAPE: the app's script holds no socket, no
+//! token and no protocol code; the host service keeps a background `tokio`
+//! runtime that owns the WebSocket transport and publishes a snapshot the
+//! synchronous `HostService::call` reads. Replies go through `Replier::send`,
+//! which wakes the Card runner (`SignalToUI`).
+//!
+//! Throwaway spike: nothing here lands in OctoSense.
+
+use std::sync::atomic::{AtomicBool, Ordering};
+use std::sync::{Arc, Mutex};
+use std::time::{Duration, Instant};
+
+use octosense_appstore::services::{HostService, Replier, ServiceCall, ServiceHost};
+use serde_json::{json, Value};
+
+use octos_app_transport::{
+    ws, Capabilities, LifecycleResult, OutboundCommand, ProfileId, SecretString, TransportConfig,
+    TransportEvent,
+};
+use octos_core::ui_protocol::SessionOpenParams;
+use url::Url;
+
+/// The snapshot the transport thread publishes for the synchronous `call`.
+#[derive(Default)]
+struct Snapshot {
+    state: String,
+    session_id: Option<String>,
+    count: Option<usize>,
+    error: Option<String>,
+}
+
+struct Core {
+    rt: tokio::runtime::Runtime,
+    snap: Arc<Mutex<Snapshot>>,
+    cmd_tx: Mutex<Option<tokio::sync::mpsc::Sender<OutboundCommand>>>,
+    started: AtomicBool,
+    base: String,
+    bearer: String,
+    profile: String,
+}
+
+/// A handle on the octoscode service.
+#[derive(Clone)]
+pub struct Octoscode {
+    core: Arc<Core>,
+}
+
+/// Offer the service to the Card runner.
+pub fn register() {
+    let _ = register_with(Options::default());
+}
+
+/// Which apps may call the service: system apps (`os.octoscode`).
+fn may_call(app_id: &str) -> bool {
+    app_id.starts_with("os.")
+}
+
+#[derive(Clone)]
+pub struct Options {
+    base: String,
+    bearer: String,
+    profile: String,
+}
+
+impl Default for Options {
+    fn default() -> Self {
+        Self {
+            base: std::env::var("OCTOS_BASE_URL")
+                .unwrap_or_else(|_| "http://127.0.0.1:50081".to_string()),
+            bearer: std::env::var("OCTOS_BEARER").unwrap_or_default(),
+            profile: std::env::var("OCTOS_PROFILE_ID").unwrap_or_else(|_| "octoscode".to_string()),
+        }
+    }
+}
+
+impl Octoscode {
+    /// Build the service and bring the transport up on its own runtime.
+    pub fn new(options: Options) -> Octoscode {
+        let rt = tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+            .expect("octoscode service: tokio runtime build");
+        let service = Octoscode {
+            core: Arc::new(Core {
+                rt,
+                snap: Arc::new(Mutex::new(Snapshot::default())),
+                cmd_tx: Mutex::new(None),
+                started: AtomicBool::new(false),
+                base: options.base,
+                bearer: options.bearer,
+                profile: options.profile,
+            }),
+        };
+        service.start();
+        service
+    }
+
+    /// Spawn the WS transport and drain its events into the snapshot.
+    fn start(&self) {
+        if self.core.started.swap(true, Ordering::SeqCst) {
+            return;
+        }
+        let base_url = Url::parse(&self.core.base)
+            .unwrap_or_else(|_| Url::parse("http://127.0.0.1:50081").unwrap());
+        let cfg = TransportConfig {
+            base_url,
+            bearer: SecretString::new(self.core.bearer.clone()),
+            profile_id: ProfileId::new(&self.core.profile),
+            cursor: None,
+            cursor_file: None,
+            requested_capabilities: Capabilities::requested(),
+            workspace_cwd: None,
+            local_kernel: false,
+        };
+        // No UI waker here: a host service has no UI thread. The snapshot is
+        // read synchronously by `call`, which itself runs off the pump.
+        let (cmd_tx, mut evt_rx) = {
+            let _guard = self.core.rt.enter();
+            ws::spawn(cfg)
+        };
+        *self.core.cmd_tx.lock().unwrap() = Some(cmd_tx.clone());
+        let snap = self.core.snap.clone();
+        self.core.rt.spawn(async move {
+            while let Some(evt) = evt_rx.recv().await {
+                let mut s = snap.lock().unwrap();
+                match evt {
+                    TransportEvent::ConnectionState(c) => s.state = format!("{c:?}"),
+                    TransportEvent::RpcResult(LifecycleResult::SessionOpen(r)) => {
+                        s.session_id = Some(r.opened.session_id.0.clone());
+                        s.error = None;
+                    }
+                    TransportEvent::SessionsListed { sessions } => {
+                        s.count = Some(sessions.as_array().map(|a| a.len()).unwrap_or(0));
+                    }
+                    TransportEvent::RpcError { method, error, .. } => {
+                        s.error = Some(format!("{method}: {}", error.message));
+                    }
+                    _ => {}
+                }
+                drop(s);
+            }
+        });
+        // Open the session immediately, so `session_open` usually answers from
+        // cache; the service stays usable if the server is not up yet.
+        let open = SessionOpenParams {
+            session_id: octos_core::SessionKey::new("octoscode", "host"),
+            topic: None,
+            profile_id: Some(self.core.profile.clone()),
+            cwd: None,
+            sandbox: None,
+            after: None,
+            client_commands: None,
+        };
+        let _ = cmd_tx.try_send(OutboundCommand::OpenSession(open));
+    }
+
+    /// Wait up to `timeout` for `ready()` against the snapshot. Returns `None`
+    /// on timeout (the caller formats the failure from `describe()`).
+    fn wait_for<T>(
+        &self,
+        timeout: Duration,
+        mut ready: impl FnMut(&Snapshot) -> Option<T>,
+    ) -> Option<T> {
+        let start = Instant::now();
+        loop {
+            if let Some(v) = ready(&self.core.snap.lock().unwrap()) {
+                return Some(v);
+            }
+            if start.elapsed() > timeout {
+                return None;
+            }
+            std::thread::sleep(Duration::from_millis(50));
+        }
+    }
+
+    fn session_open(&self) -> Result<Value, String> {
+        // Ensure the transport is up (idempotent) and the session is opening.
+        self.start();
+        if let Some(sid) = self.wait_for(Duration::from_secs(15), |s| s.session_id.clone()) {
+            return Ok(json!({ "session_id": sid }));
+        }
+        Err(format!("session/open did not complete: {}", self.describe()))
+    }
+
+    fn session_list(&self) -> Result<Value, String> {
+        let tx = self.core.cmd_tx.lock().unwrap().clone();
+        let Some(tx) = tx else {
+            return Err("transport not started yet".to_string());
+        };
+        {
+            let mut s = self.core.snap.lock().unwrap();
+            s.count = None;
+        }
+        let _ = tx.try_send(OutboundCommand::ListSessions);
+        if let Some(count) = self.wait_for(Duration::from_secs(15), |s| s.count) {
+            return Ok(json!({ "count": count }));
+        }
+        Err(format!("session/list did not answer: {}", self.describe()))
+    }
+
+    fn describe(&self) -> String {
+        let s = self.core.snap.lock().unwrap();
+        match &s.error {
+            Some(e) => format!("state={} err={e}", s.state),
+            None => format!("state={}", s.state),
+        }
+    }
+}
+
+/// Register the service with the Card runner.
+pub fn register_with(options: Options) -> Octoscode {
+    let service = Octoscode::new(options);
+    octosense_appstore::services::register_host_service(Box::new(OctoscodeService {
+        inner: service.clone(),
+    }));
+    service
+}
+
+pub struct OctoscodeService {
+    inner: Octoscode,
+}
+
+impl HostService for OctoscodeService {
+    fn family(&self) -> &'static str {
+        "octoscode"
+    }
+
+    fn call(&mut self, call: ServiceCall, reply: Replier, _host: &mut dyn ServiceHost) {
+        if !may_call(&call.app_id) {
+            reply.send(Err("The octoscode service serves system apps only.".into()));
+            return;
+        }
+        let inner = self.inner.clone();
+        match call.method() {
+            // Offload to a worker thread: `call` runs on the host's pump and
+            // must not block it while the WS round trip completes.
+            "session_open" => work(move || reply.send(inner.session_open())),
+            "session_list" => work(move || reply.send(inner.session_list())),
+            other => reply.send(Err(format!("octoscode has no method {other:?}"))),
+        }
+    }
+}
+
+fn work(f: impl FnOnce() + Send + 'static) {
+    std::thread::spawn(f);
+}
