diff --git a/apps/octoscode/bundle/main.splash b/apps/octoscode/bundle/main.splash
new file mode 100644
index 0000000..2894fdd
--- /dev/null
+++ b/apps/octoscode/bundle/main.splash
@@ -0,0 +1,44 @@
+// OctosCode — D9 spike, shape (ii): a CONTAINED OctoScript app.
+//
+// It holds no socket, no token and no protocol code: every octos call goes
+// through `host.request("octoscode.<method>", …)`, answered by the Rust host
+// service `apps/octoscode/host-service` (capability family `octoscode`).
+// Throwaway spike: nothing here lands in OctoSense.
+
+fn set_session(text){ ui.session.set_text(text) }
+fn set_status(text){ ui.status.set_text(text) }
+
+fn ask_open(){
+    set_status("conn: asking host for session/open…")
+    host.request("octoscode.session_open", {}, fn(r){
+        if r.is_ok { set_session("session: " + r.data.session_id) set_status("conn: session open") }
+        else { set_status("err: " + r.error) }
+    })
+}
+
+fn ask_list(){
+    set_status("conn: asking host for session/list…")
+    host.request("octoscode.session_list", {}, fn(r){
+        if r.is_ok { set_status("conn: sessions listed: " + r.data.count) }
+        else { set_status("err: " + r.error) }
+    })
+}
+
+fn boot(){
+    if host.has("octoscode") { ask_open() }
+    else { set_status("err: no octoscode service on this host") }
+}
+start_timeout(0.05, || boot())
+
+HostedView{width: Fill height: Fill
+    full: View{width: Fill height: Fill flow: Down show_bg: true draw_bg.color: #xf2f2f7
+        main := View{width: Fill height: Fill flow: Down padding: 24 spacing: 14
+            Label{text: "OctosCode — contained bundle"
+                draw_text.color: #x1c1c1e draw_text.text_style: theme.font_bold{font_size: 20}}
+            session := Label{width: Fill text: "session: (opening…)" draw_text.color: #x1c1c1e}
+            status := Label{width: Fill text: "conn: idle" draw_text.color: #x8e8e93}
+            refresh := ButtonFlat{text: "session/list" on_click: || ask_list()
+                draw_text.color: #xe0245e}
+        }
+    }
+}
