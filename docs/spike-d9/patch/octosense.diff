index 0000000..6d33ec1
--- /dev/null
+++ b/apps/octoscode/module/src/lib.rs
@@ -0,0 +1,265 @@
+//! octosense-octoscode — shape (i): a NATIVE `AppModule` that reaches a local
+//! `octos serve` over the UI Protocol WebSocket, calls `session/open`, shows
+//! the session id in a Label, and has a Button that calls `session/list` and
+//! shows the count. Throwaway D9 spike: nothing here lands in OctoSense.
+//!
+//! The only thing this crate proves is the SHAPE: that a new app authored as a
+//! linked `AppModule` can reuse AppCard's `octos-app-transport` /
+//! `octos-app-store` crates directly, in-process, with no host service and no
+//! bundle. The UI thread never blocks: a `tokio` runtime owns the transport on
+//! a background thread, and the transport's waker (`SignalToUI`) wakes the UI
+//! thread to drain the results into the labels.
+
+pub use makepad_widgets;
+use makepad_widgets::*;
+use makepad_app_module::{
+    makepad_ai_services::wire::{ServiceCall, ServiceManifest, ToolResult},
+    AppModule, ExecOutcome, InstanceHandles, InstanceParts, OpenSchema, ServiceExecutor,
+    ValidatedOpen,
+};
+use std::sync::{Arc, Mutex};
+
+use octos_app_transport::{
+    ws, Capabilities, LifecycleResult, OutboundCommand, ProfileId, SecretString, TransportConfig,
+    TransportEvent,
+};
+use octos_core::ui_protocol::SessionOpenParams;
+use url::Url;
+
+script_mod! {
+    use mod.prelude.widgets.*
+    mod.widgets.OctoscodeView = set_type_default() do #(OctoscodeView::register_widget(vm)) {
+        ..mod.widgets.RectView
+        width: Fill height: Fill
+        draw_bg.color: theme.color_bg_app
+        flow: Down padding: 24 spacing: 14
+        heading := Label {
+            text: "OctosCode — native AppModule"
+            draw_text.text_style.font_size: 20
+        }
+        session := Label { width: Fill text: "session: (opening…)" }
+        status := Label { width: Fill draw_text.wrap: Words text: "conn: idle" }
+        refresh := Button { text: "session/list" }
+    }
+}
+
+/// What the background transport thread publishes for the UI thread to read.
+/// The UI thread locks it briefly on `Event::Signal` and on a button click.
+#[derive(Default)]
+struct Bridge {
+    state: String,
+    session_id: Option<String>,
+    count: Option<usize>,
+    error: Option<String>,
+    cmd_tx: Option<tokio::sync::mpsc::Sender<OutboundCommand>>,
+}
+
+#[derive(Script, ScriptHook, Widget)]
+pub struct OctoscodeView {
+    #[deref]
+    view: View,
+    #[rust]
+    bridge: Arc<Mutex<Bridge>>,
+    #[rust]
+    runtime: Option<tokio::runtime::Runtime>,
+    #[rust]
+    started: bool,
+}
+
+impl OctoscodeView {
+    /// Bring up the transport on its own runtime and drive one
+    /// `session/open` → `session/list` round trip. Never called twice.
+    fn start(&mut self) {
+        let base =
+            std::env::var("OCTOS_BASE_URL").unwrap_or_else(|_| "http://127.0.0.1:50081".to_string());
+        let bearer = std::env::var("OCTOS_BEARER").unwrap_or_default();
+        let profile =
+            std::env::var("OCTOS_PROFILE_ID").unwrap_or_else(|_| "octoscode".to_string());
+        let base_url =
+            Url::parse(&base).unwrap_or_else(|_| Url::parse("http://127.0.0.1:50081").unwrap());
+
+        let cfg = TransportConfig {
+            base_url,
+            bearer: SecretString::new(bearer),
+            profile_id: ProfileId::new(&profile),
+            cursor: None,
+            cursor_file: None,
+            requested_capabilities: Capabilities::requested(),
+            workspace_cwd: None,
+            local_kernel: false,
+        };
+
+        let runtime = match tokio::runtime::Builder::new_multi_thread()
+            .worker_threads(1)
+            .enable_all()
+            .build()
+        {
+            Ok(rt) => rt,
+            Err(e) => {
+                self.bridge.lock().unwrap().error = Some(format!("runtime: {e}"));
+                return;
+            }
+        };
+
+        // `ws::spawn_with_waker` calls `tokio::spawn`, so it must run inside
+        // the runtime context; the waker wakes the makepad UI thread whenever
+        // an event is queued (otherwise a reply lands while the UI is idle).
+        let (cmd_tx, mut evt_rx) = {
+            let _guard = runtime.enter();
+            ws::spawn_with_waker(
+                cfg,
+                Some(Arc::new(|| SignalToUI::set_ui_signal())),
+            )
+        };
+
+        {
+            let mut b = self.bridge.lock().unwrap();
+            b.cmd_tx = Some(cmd_tx.clone());
+            b.state = "dialing".to_string();
+        }
+
+        let open = SessionOpenParams {
+            session_id: octos_core::SessionKey::new("octoscode", "main"),
+            topic: None,
+            profile_id: Some(profile),
+            cwd: None,
+            sandbox: None,
+            after: None,
+            client_commands: None,
+        };
+
+        let bridge = self.bridge.clone();
+        runtime.spawn(async move {
+            if cmd_tx.send(OutboundCommand::OpenSession(open)).await.is_err() {
+                bridge.lock().unwrap().error = Some("transport channel closed".to_string());
+                SignalToUI::set_ui_signal();
+                return;
+            }
+            while let Some(evt) = evt_rx.recv().await {
+                match evt {
+                    TransportEvent::ConnectionState(s) => {
+                        bridge.lock().unwrap().state = format!("{s:?}");
+                    }
+                    TransportEvent::RpcResult(LifecycleResult::SessionOpen(r)) => {
+                        let sid = r.opened.session_id.0.clone();
+                        let mut b = bridge.lock().unwrap();
+                        b.session_id = Some(sid);
+                        b.error = None;
+                    }
+                    TransportEvent::SessionsListed { sessions } => {
+                        let n = sessions.as_array().map(|a| a.len()).unwrap_or(0);
+                        bridge.lock().unwrap().count = Some(n);
+                    }
+                    TransportEvent::RpcError { method, error, .. } => {
+                        bridge.lock().unwrap().error =
+                            Some(format!("{method}: {}", error.message));
+                    }
+                    _ => {}
+                }
+                SignalToUI::set_ui_signal();
+            }
+        });
+
+        self.runtime = Some(runtime);
+    }
+
+    fn sync_labels(&mut self, cx: &mut Cx) {
+        let (session, status) = {
+            let b = self.bridge.lock().unwrap();
+            let session = match &b.session_id {
+                Some(id) => format!("session: {id}"),
+                None => "session: (opening…)".to_string(),
+            };
+            let mut status = format!("conn: {}", if b.state.is_empty() { "idle" } else { &b.state });
+            if let Some(n) = b.count {
+                status.push_str(&format!("   sessions listed: {n}"));
+            }
+            if let Some(e) = &b.error {
+                status.push_str(&format!("   err: {e}"));
+            }
+            (session, status)
+        };
+        self.view.label(cx, ids!(session)).set_text(cx, &session);
+        self.view.label(cx, ids!(status)).set_text(cx, &status);
+        makepad_widgets::log!("[octoscode] {session} | {status}");
+    }
+}
+
+impl Widget for OctoscodeView {
+    fn draw_walk(&mut self, cx: &mut Cx2d, scope: &mut Scope, walk: Walk) -> DrawStep {
+        self.view.draw_walk(cx, scope, walk)
+    }
+
+    fn handle_event(&mut self, cx: &mut Cx, event: &Event, scope: &mut Scope) {
+        self.view.handle_event(cx, event, scope);
+        // Modules receive `Event::Startup` on first contact; start on the first
+        // event of any kind so a missed Startup cannot wedge the spike.
+        if !self.started {
+            self.started = true;
+            self.start();
+            self.sync_labels(cx);
+        }
+        match event {
+            Event::Signal => self.sync_labels(cx),
+            Event::Actions(actions) => {
+                if self.view.button(cx, ids!(refresh)).clicked(actions) {
+                    let b = self.bridge.lock().unwrap();
+                    if let Some(tx) = &b.cmd_tx {
+                        let _ = tx.try_send(OutboundCommand::ListSessions);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+pub struct OctoscodeModule;
+pub static OCTOSCODE_MODULE: OctoscodeModule = OctoscodeModule;
+
+impl AppModule for OctoscodeModule {
+    fn id(&self) -> &'static str {
+        "octoscode"
+    }
+    fn label(&self) -> &'static str {
+        "OctosCode"
+    }
+    fn register(&self, vm: &mut ScriptVm) {
+        script_mod(vm);
+    }
+    fn open_schema(&self) -> OpenSchema {
+        OpenSchema::new(1)
+    }
+    fn capabilities(&self) -> &'static [&'static str] {
+        &[]
+    }
+    fn create(
+        &self,
+        vm: &mut ScriptVm,
+        _open: ValidatedOpen,
+        _handles: InstanceHandles,
+    ) -> InstanceParts {
+        let value = script_eval!(vm, {
+            use mod.widgets.*
+            OctoscodeView {}
+        });
+        InstanceParts {
+            root: WidgetRef::script_from_value(vm, value),
+            executor: Box::new(OctoscodeExecutor),
+            shutdown: Box::new(|_| {}),
+        }
+    }
+}
+
+struct OctoscodeExecutor;
+impl ServiceExecutor for OctoscodeExecutor {
+    fn manifest(&self) -> ServiceManifest {
+        ServiceManifest::new("octoscode", "OctosCode", "Minimal octoscode app (native module).")
+    }
+    fn execute(&mut self, _cx: &mut Cx, call: &ServiceCall) -> ExecOutcome {
+        ExecOutcome::Done(ToolResult::unavailable(
+            &call.call_id,
+            "OctosCode (native module) has no tools",
+        ))
+    }
+}
