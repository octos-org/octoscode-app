+    fn hydrate_reply(id: &str, session: &str, seq: u64) -> String {
+        serde_json::json!({"jsonrpc": "2.0", "id": id, "result": {
+            "session_id": session, "cursor": {"stream": session, "seq": seq}, "messages": []
+        }})
+        .to_string()
+    }
