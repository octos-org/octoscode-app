+++ b/apps/appcard/app/app/src/app/l0_eval.rs
@@ -261,6 +261,11 @@ fn walk_inner(vm: &mut ScriptVm, value: ScriptValue, depth: usize, remaining: &m
         padtop: f32_prop(vm, value, id!(padtop)),
         padleft: f32_prop(vm, value, id!(padleft)),
         padbottom: f32_prop(vm, value, id!(padbottom)),
+        // #18e's `padright` (patches/octoscript-makepad/0006-18e-padright.patch)
+        // added the FIELD to octoscript_node's Attrs, but the fork's own
+        // initializer was never updated, so the crate stopped compiling. Same
+        // shape as its four sibling padding fields above.
+        padright: f32_prop(vm, value, id!(padright)),
         spacing: f32_prop(vm, value, id!(spacing)),
         margin: f32_prop(vm, value, id!(margin)),
         marginx: f32_prop(vm, value, id!(marginx)),
