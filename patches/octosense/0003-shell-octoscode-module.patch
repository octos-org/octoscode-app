 # --- App Hub: the shells' store/Card runner/system apps crate and the host
 # service registry the Mail and llm services register into. One revision.
@@ -103,6 +108,12 @@ octosense-mail-service = { path = "apps/mail/host-service" }
 octosense-news-service = { path = "apps/news/host-service" }
 octosense-reference = { path = "apps/reference" }
 octosense-appcard = { path = "apps/appcard/module" }
+# Phase-1 core: the octoscode client/store/module, vendored at build time from
+# the octoscode-app repo into apps/octoscode/ (with its design/ in apps/design)
+# so they resolve against the in-tree octos-app-transport / -store below.
+octoscode-client = { path = "apps/octoscode/client" }
+octoscode-store = { path = "apps/octoscode/store" }
+octoscode-module = { path = "apps/octoscode/module" }
 octosense-news = { path = "apps/news/native" }
 octosense-photos = { path = "apps/photos/native" }
 octosense-maps = { path = "apps/maps/native" }
@@ -204,9 +215,15 @@ makepad-code-editor = { path = ".sources/makepad/code_editor" }
 octoscript-ui-l0 = { path = ".sources/octoscript/crates/octoscript-ui-l0" }
 
 [patch."https://github.com/OctoSense-org/Octoscript-Makepad.git"]
-octoscript-makepad = { path = ".sources/octoscript-makepad/crates/octoscript-makepad" }
-octoscript-widgets = { path = ".sources/octoscript-makepad/crates/octoscript-widgets" }
-octoscript-node = { path = ".sources/octoscript-makepad/crates/octoscript-node" }
+# The octoscode module renders through the octoscode repo's renderer fork
+# (this same rev 6881fb6 + its patches/octoscript-makepad/*, prepared by its
+# tools/prepare-octoscript-makepad-fork.sh): the clean .sources checkout lacks
+# to_makepad_ui_in_slot, which the vendored module calls. The fork sits BESIDE
+# this tree (../octoscript-makepad-fork); the octoscode repo's
+# tools/build-macos.sh --octosense lays the two out that way.
+octoscript-makepad = { path = "../octoscript-makepad-fork/crates/octoscript-makepad" }
+octoscript-widgets = { path = "../octoscript-makepad-fork/crates/octoscript-widgets" }
+octoscript-node = { path = "../octoscript-makepad-fork/crates/octoscript-node" }
 
 # Rinx still takes the app-peers contract by git from OctoSense-System-Apps
 # (archived; it was imported into this repository): that code lives here
diff --git a/apps/appcard/app/app/src/app/l0_eval.rs b/apps/appcard/app/app/src/app/l0_eval.rs
