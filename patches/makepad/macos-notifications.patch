+//! System notifications with an identity: post a notice, withdraw it, read or
+//! ask for the permission to post, and learn when the person clicks one.
+//!
+//! - [`Cx::post_notification`] shows (or replaces) the notice keyed by `id`.
+//!   Posting never brings the app forward.
+//! - [`Cx::close_notification`] withdraws the notice keyed by `id`, shown or
+//!   still pending.
+//! - [`Cx::query_notification_authorization`] reads the current permission;
+//!   [`Cx::request_notification_authorization`] asks for it (the OS may show
+//!   its own prompt, once). Both answer with a
+//!   [`NotificationAuthorizationResult`].
+//! - A click on a notice brings the app forward (macOS activates the app and
+//!   orders its main window front; Android resumes the activity) and then
+//!   arrives as a [`NotificationClicked`] carrying the notice's `id`.
+//! - A notice the OS refused to show arrives as a [`NotificationFailed`].
+//! - [`Cx::focused_window`]: the window that has focus now, so code created
+//!   after the last focus event (a module opened mid-run) can still tell
+//!   whether the person is looking at the app.
+//!
+//! Every answer is a bare action sent with [`Cx::post_action`], from whatever
+//! thread the OS answered on; handle it in `Event::Actions`:
+//!
+//! ```ignore
+//! if let Event::Actions(actions) = event {
+//!     for action in actions.iter() {
+//!         if let Some(click) = action.downcast_ref::<NotificationClicked>() {
+//!             // open whatever `click.id` names
+//!         }
+//!     }
+//! }
+//! ```
+//!
+//! Backends:
+//! - macOS: UserNotifications (`UNUserNotificationCenter`). It needs a real
+//!   app bundle — in a bare binary it raises an Objective-C exception that
+//!   aborts the process (platform/build.rs embeds a bundle id even there) —
+//!   so unless the main bundle is an `.app` with an identifier, every query
+//!   answers [`NotificationAuthorization::Unavailable`] and posts are dropped.
+//! - Android: `NotificationManager`; the `POST_NOTIFICATIONS` runtime
+//!   permission from API 33 (declared by cargo-makepad's manifest).
+//! - Every other target answers `Unavailable`.
+//!
+//! The older [`Cx::show_notification`] (no id, no answers) is unchanged.
+
+use crate::{cx::Cx, window::WindowId};
+
+/// Whether this process may post system notifications.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum NotificationAuthorization {
+    /// Notifications cannot be posted from this process at all: no backend,
+    /// or a macOS binary that does not run from an `.app` bundle.
+    Unavailable,
+    /// Not decided yet: a request will ask the person.
+    NotDetermined,
+    /// The person allowed notifications.
+    Granted,
+    /// The person (or a policy) refused; only the system settings change it.
+    Denied,
+}
+
+/// The answer to [`Cx::query_notification_authorization`] or
+/// [`Cx::request_notification_authorization`]. A post that finds the
+/// permission gone answers with one too (`requested: false`) instead of
+/// posting.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NotificationAuthorizationResult {
+    pub status: NotificationAuthorization,
+    /// `true` when this answers a request, `false` for a query (or the check a
+    /// post makes first).
+    pub requested: bool,
+    /// The OS reported an error for the request; `status` is then the state
+    /// read back afterwards.
+    pub error: Option<String>,
+}
+
+/// A notice posted with [`Cx::post_notification`] was clicked (its default
+/// action). The app was already brought forward.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NotificationClicked {
+    pub id: String,
+}
+
+/// A notice posted with [`Cx::post_notification`] could not be shown.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct NotificationFailed {
+    pub id: String,
+    pub error: String,
+}
+
+impl Cx {
+    /// Show the notice keyed by `id`, replacing an earlier one with the same
+    /// id. When the permission is not granted the notice is not posted and a
+    /// [`NotificationAuthorizationResult`] (`requested: false`) says why.
+    pub fn post_notification(&mut self, id: &str, title: &str, body: &str) {
+        #[cfg(target_os = "macos")]
+        crate::os::apple::macos::macos_notifications::post(id, title, body);
+        #[cfg(target_os = "android")]
+        unsafe {
+            crate::os::linux::android::android_jni::to_java_post_notification(id, title, body);
+        }
+        #[cfg(not(any(target_os = "macos", target_os = "android")))]
+        {
+            let _ = (id, title, body);
+            Self::answer_unavailable(false);
+        }
+    }
+
+    /// Withdraw the notice keyed by `id` (shown or pending). Unknown ids are
+    /// ignored.
+    pub fn close_notification(&mut self, id: &str) {
+        #[cfg(target_os = "macos")]
+        crate::os::apple::macos::macos_notifications::close(id);
+        #[cfg(target_os = "android")]
+        unsafe {
+            crate::os::linux::android::android_jni::to_java_close_notification(id);
+        }
+        #[cfg(not(any(target_os = "macos", target_os = "android")))]
+        let _ = id;
+    }
+
+    /// Read the current permission; never prompts. Answers with a
+    /// [`NotificationAuthorizationResult`] (`requested: false`).
+    pub fn query_notification_authorization(&mut self) {
+        self.notification_authorization(false);
+    }
+
+    /// Ask for the permission; the OS may show its prompt (once — a decided
+    /// permission answers at once). Answers with a
+    /// [`NotificationAuthorizationResult`] (`requested: true`), which may come
+    /// much later: the OS prompt waits for the person.
+    pub fn request_notification_authorization(&mut self) {
+        self.notification_authorization(true);
+    }
+
+    /// The window that has focus now (the last `WindowGotFocus` not followed
+    /// by its `WindowLostFocus`), or `None` while the app is in the
+    /// background or before any window was focused.
+    pub fn focused_window(&self) -> Option<WindowId> {
+        self.focused_window
+    }
+
+    fn notification_authorization(&mut self, request: bool) {
+        #[cfg(target_os = "macos")]
+        crate::os::apple::macos::macos_notifications::authorization(request);
+        #[cfg(target_os = "android")]
+        unsafe {
+            crate::os::linux::android::android_jni::to_java_notification_authorization(request);
+        }
+        #[cfg(not(any(target_os = "macos", target_os = "android")))]
+        Self::answer_unavailable(request);
+    }
+
+    #[allow(dead_code)]
+    pub(crate) fn answer_unavailable(requested: bool) {
+        Cx::post_action(NotificationAuthorizationResult {
+            status: NotificationAuthorization::Unavailable,
+            requested,
+            error: None,
+        });
+    }
+}
