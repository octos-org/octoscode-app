+//! macOS system notifications through UserNotifications
+//! (`UNUserNotificationCenter`): the backend of [`crate::notification`].
+//!
+//! `UNUserNotificationCenter` needs a real app bundle. In a bare binary — a
+//! `cargo run` build, whose Info.plist platform/build.rs embeds, bundle id
+//! included — `currentNotificationCenter` raises an Objective-C exception that
+//! aborts the process. Nothing here touches the center unless the main bundle
+//! is an `.app` with an identifier; otherwise every query answers
+//! `Unavailable` and a post is dropped with a log line.
+//!
+//! Threads: the center runs its completion handlers on a private queue and
+//! calls its delegate on the main thread. Every answer leaves through
+//! `Cx::post_action`, which is safe from any thread and wakes the event loop.
+
+use {
+    crate::{
+        cx::Cx,
+        notification::{
+            NotificationAuthorization, NotificationAuthorizationResult, NotificationClicked,
+            NotificationFailed,
+        },
+        os::{
+            apple::apple_sys::*,
+            apple_util::{nsstring_to_string, str_to_nsstring},
+        },
+    },
+    std::sync::OnceLock,
+};
+
+#[link(name = "UserNotifications", kind = "framework")]
+extern "C" {
+    /// The action identifier of a plain click on the notice.
+    static UNNotificationDefaultActionIdentifier: ObjcId;
+}
+
+// UNAuthorizationOptions
+const UN_AUTHORIZATION_OPTION_BADGE: u64 = 1 << 0;
+const UN_AUTHORIZATION_OPTION_SOUND: u64 = 1 << 1;
+const UN_AUTHORIZATION_OPTION_ALERT: u64 = 1 << 2;
+// UNAuthorizationStatus (NSInteger)
+const UN_AUTHORIZATION_STATUS_NOT_DETERMINED: i64 = 0;
+const UN_AUTHORIZATION_STATUS_DENIED: i64 = 1;
+// UNNotificationPresentationOptions (macOS 11+)
+const UN_PRESENTATION_OPTION_SOUND: u64 = 1 << 1;
+const UN_PRESENTATION_OPTION_LIST: u64 = 1 << 3;
+const UN_PRESENTATION_OPTION_BANNER: u64 = 1 << 4;
+
+/// Whether this process runs from an `.app` bundle with an identifier: the
+/// only case `UNUserNotificationCenter` serves. Decided once per process.
+fn bundle_is_app() -> bool {
+    static IS_APP: OnceLock<bool> = OnceLock::new();
+    *IS_APP.get_or_init(|| unsafe {
+        let bundle: ObjcId = msg_send![class!(NSBundle), mainBundle];
+        if bundle == nil {
+            return false;
+        }
+        let ident: ObjcId = msg_send![bundle, bundleIdentifier];
+        let path: ObjcId = msg_send![bundle, bundlePath];
+        let is_app = ident != nil && path != nil && nsstring_to_string(path).ends_with(".app");
+        if !is_app {
+            crate::log!(
+                "notifications: unavailable — this process does not run from an .app bundle"
+            );
+        }
+        is_app
+    })
+}
+
+/// The process's notification center with our delegate installed, or `None`
+/// outside an `.app` bundle. Main thread (the `Cx` methods call it).
+fn center() -> Option<ObjcId> {
+    if !bundle_is_app() {
+        return None;
+    }
+    unsafe {
+        let center: ObjcId = msg_send![class!(UNUserNotificationCenter), currentNotificationCenter];
+        if center == nil {
+            return None;
+        }
+        install_delegate(center);
+        Some(center)
+    }
+}
+
+/// The center from a completion handler: the bundle check already passed
+/// for the call that scheduled it.
+unsafe fn current_center() -> ObjcId {
+    msg_send![class!(UNUserNotificationCenter), currentNotificationCenter]
+}
+
+fn map_status(status: i64) -> NotificationAuthorization {
+    match status {
+        UN_AUTHORIZATION_STATUS_NOT_DETERMINED => NotificationAuthorization::NotDetermined,
+        UN_AUTHORIZATION_STATUS_DENIED => NotificationAuthorization::Denied,
+        // Authorized, provisional (quiet delivery) and ephemeral all post.
+        2 | 3 | 4 => NotificationAuthorization::Granted,
+        _ => NotificationAuthorization::NotDetermined,
+    }
+}
+
+unsafe fn error_text(error: ObjcId) -> Option<String> {
+    if error == nil {
+        return None;
+    }
+    let text: ObjcId = msg_send![error, localizedDescription];
+    Some(if text == nil { "unknown error".to_string() } else { nsstring_to_string(text) })
+}
+
+/// Read the settled permission and hand it to `answer`.
+unsafe fn with_status(answer: impl Fn(NotificationAuthorization) + 'static) {
+    let handler = objc_block!(move |settings: ObjcId| {
+        let status: i64 = msg_send![settings, authorizationStatus];
+        answer(map_status(status));
+    });
+    let () = msg_send![current_center(), getNotificationSettingsWithCompletionHandler: &handler];
+}
+
+/// `Cx::query_notification_authorization` / `request_notification_authorization`.
+pub fn authorization(request: bool) {
+    if center().is_none() {
+        Cx::answer_unavailable(request);
+        return;
+    }
+    unsafe {
+        if !request {
+            with_status(move |status| {
+                Cx::post_action(NotificationAuthorizationResult { status, requested: false, error: None })
+            });
+            return;
+        }
+        let handler = objc_block!(move |_granted: BOOL, error: ObjcId| {
+            // `granted` cannot tell a refusal from a dismissed or failed
+            // prompt: report the state the request left behind.
+            let error = error_text(error);
+            with_status(move |status| {
+                Cx::post_action(NotificationAuthorizationResult {
+                    status,
+                    requested: true,
+                    error: error.clone(),
+                })
+            });
+        });
+        let options =
+            UN_AUTHORIZATION_OPTION_ALERT | UN_AUTHORIZATION_OPTION_SOUND | UN_AUTHORIZATION_OPTION_BADGE;
+        let () = msg_send![
+            current_center(),
+            requestAuthorizationWithOptions: options
+            completionHandler: &handler
+        ];
+    }
+}
+
+/// `Cx::post_notification`: check the permission, then add the request (the
+/// same identifier replaces the earlier notice).
+pub fn post(id: &str, title: &str, body: &str) {
+    if center().is_none() {
+        crate::log!("notifications: {id:?} not posted (unavailable outside an .app bundle)");
+        Cx::answer_unavailable(false);
+        return;
+    }
+    let (id, title, body) = (id.to_string(), title.to_string(), body.to_string());
+    unsafe {
+        with_status(move |status| {
+            if status != NotificationAuthorization::Granted {
+                Cx::post_action(NotificationAuthorizationResult { status, requested: false, error: None });
+                return;
+            }
+            add_request(&id, &title, &body);
+        });
+    }
+}
+
+unsafe fn add_request(id: &str, title: &str, body: &str) {
+    let pool: ObjcId = msg_send![class!(NSAutoreleasePool), new];
+    let content: ObjcId = msg_send![class!(UNMutableNotificationContent), new];
+    let () = msg_send![content, setTitle: str_to_nsstring(title)];
+    let () = msg_send![content, setBody: str_to_nsstring(body)];
+    let sound: ObjcId = msg_send![class!(UNNotificationSound), defaultSound];
+    let () = msg_send![content, setSound: sound];
+    let request: ObjcId = msg_send![
+        class!(UNNotificationRequest),
+        requestWithIdentifier: str_to_nsstring(id)
+        content: content
+        trigger: nil
+    ];
+    let () = msg_send![content, release];
+    let failed_id = id.to_string();
+    let done = objc_block!(move |error: ObjcId| {
+        if let Some(error) = error_text(error) {
+            crate::log!("notifications: {failed_id:?} was not shown: {error}");
+            Cx::post_action(NotificationFailed { id: failed_id.clone(), error });
+        }
+    });
+    let () = msg_send![current_center(), addNotificationRequest: request withCompletionHandler: &done];
+    let () = msg_send![pool, drain];
+}
+
+/// `Cx::close_notification`: withdraw it from Notification Center, and from
+/// the pending queue if it was not delivered yet.
+pub fn close(id: &str) {
+    let Some(center) = center() else { return };
+    unsafe {
+        let ids: ObjcId = msg_send![class!(NSArray), arrayWithObject: str_to_nsstring(id)];
+        let () = msg_send![center, removeDeliveredNotificationsWithIdentifiers: ids];
+        let () = msg_send![center, removePendingNotificationRequestsWithIdentifiers: ids];
+    }
+}
+
+/// Bring the app forward for a click: activate it and order its main window
+/// front (deminiaturized). A hidden test instance (`MAKEPAD_HIDE_WINDOWS`)
+/// keeps its windows off screen.
+unsafe fn bring_forward() {
+    let ns_app: ObjcId = msg_send![class!(NSApplication), sharedApplication];
+    let () = msg_send![ns_app, activateIgnoringOtherApps: YES];
+    if std::env::var_os("MAKEPAD_HIDE_WINDOWS").is_some() {
+        return;
+    }
+    let windows: ObjcId = msg_send![ns_app, windows];
+    let count: usize = msg_send![windows, count];
+    for i in 0..count {
+        let window: ObjcId = msg_send![windows, objectAtIndex: i];
+        let can_be_main: BOOL = msg_send![window, canBecomeMainWindow];
+        if can_be_main == YES {
+            let miniaturized: BOOL = msg_send![window, isMiniaturized];
+            if miniaturized == YES {
+                let () = msg_send![window, deminiaturize: nil];
+            }
+            let () = msg_send![window, makeKeyAndOrderFront: nil];
+            break;
+        }
+    }
+}
+
+extern "C" fn did_receive_response(
+    _this: &Object,
+    _sel: Sel,
+    _center: ObjcId,
+    response: ObjcId,
+    completion: ObjcId,
+) {
+    unsafe {
+        let action: ObjcId = msg_send![response, actionIdentifier];
+        let notification: ObjcId = msg_send![response, notification];
+        let request: ObjcId = msg_send![notification, request];
+        let ident: ObjcId = msg_send![request, identifier];
+        let is_click: BOOL = msg_send![action, isEqualToString: UNNotificationDefaultActionIdentifier];
+        if is_click == YES {
+            let id = nsstring_to_string(ident);
+            crate::log!("notifications: {id:?} clicked");
+            bring_forward();
+            Cx::post_action(NotificationClicked { id });
+        }
+        objc_block_invoke!(completion, invoke());
+    }
+}
+
+extern "C" fn will_present(
+    _this: &Object,
+    _sel: Sel,
+    _center: ObjcId,
+    _notification: ObjcId,
+    completion: ObjcId,
+) {
+    // Show the banner even while the app is frontmost: the app decides when
+    // a notice is due (e.g. only while its window is not focused).
+    let options = UN_PRESENTATION_OPTION_BANNER | UN_PRESENTATION_OPTION_LIST | UN_PRESENTATION_OPTION_SOUND;
+    unsafe {
+        objc_block_invoke!(completion, invoke((options): u64));
+    }
+}
+
+/// Install the `UNUserNotificationCenterDelegate` once (it receives the
+/// clicks). The center keeps a weak reference: the instance lives for the
+/// process.
+unsafe fn install_delegate(center: ObjcId) {
+    static DELEGATE: OnceLock<usize> = OnceLock::new();
+    DELEGATE.get_or_init(|| {
+        let superclass = class!(NSObject);
+        let mut decl = ClassDecl::new("MakepadUserNotificationDelegate", superclass)
+            .expect("MakepadUserNotificationDelegate is declared once");
+        decl.add_method(
+            sel!(userNotificationCenter:didReceiveNotificationResponse:withCompletionHandler:),
+            did_receive_response as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId),
+        );
+        decl.add_method(
+            sel!(userNotificationCenter:willPresentNotification:withCompletionHandler:),
+            will_present as extern "C" fn(&Object, Sel, ObjcId, ObjcId, ObjcId),
+        );
+        if let Some(protocol) = Protocol::get("UNUserNotificationCenterDelegate") {
+            decl.add_protocol(protocol);
+        }
+        let class = decl.register();
+        let delegate: ObjcId = msg_send![class, new];
+        let () = msg_send![center, setDelegate: delegate];
+        delegate as usize
+    });
+}
