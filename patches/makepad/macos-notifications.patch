+
+// ---- System notifications with an id (`crate::notification`) -------------
+// The activity posts, withdraws and authorizes on its own looper and answers
+// through the `onNotification*` callbacks below.
+
+pub unsafe fn to_java_post_notification(id: &str, title: &str, body: &str) {
+    let env = attach_jni_env();
+    let id = new_java_string(env, id);
+    let title = new_java_string(env, title);
+    let body = new_java_string(env, body);
+    ndk_utils::call_void_method!(
+        env,
+        get_activity(),
+        "postNotification",
+        "(Ljava/lang/String;Ljava/lang/String;Ljava/lang/String;)V",
+        id,
+        title,
+        body
+    );
+    ((**env).DeleteLocalRef.unwrap())(env, id);
+    ((**env).DeleteLocalRef.unwrap())(env, title);
+    ((**env).DeleteLocalRef.unwrap())(env, body);
+}
+
+pub unsafe fn to_java_close_notification(id: &str) {
+    let env = attach_jni_env();
+    let id = new_java_string(env, id);
+    ndk_utils::call_void_method!(env, get_activity(), "closeNotification", "(Ljava/lang/String;)V", id);
+    ((**env).DeleteLocalRef.unwrap())(env, id);
+}
+
+pub unsafe fn to_java_notification_authorization(request: bool) {
+    let env = attach_jni_env();
+    ndk_utils::call_void_method!(
+        env,
+        get_activity(),
+        "notificationAuthorization",
+        "(Z)V",
+        request as jni_sys::jboolean as c_uint
     );
 }
 
+unsafe fn jstring_lossy(env: *mut jni_sys::JNIEnv, java_string: jni_sys::jstring) -> String {
+    if java_string.is_null() {
+        return String::new();
+    }
+    let chars = (**env).GetStringUTFChars.unwrap()(env, java_string, std::ptr::null_mut());
+    let text = std::ffi::CStr::from_ptr(chars).to_string_lossy().into_owned();
+    (**env).ReleaseStringUTFChars.unwrap()(env, java_string, chars);
+    text
+}
+
+/// A click on a notice posted with an id (`MakepadActivity.onNewIntent`);
+/// the activity is already in front.
+#[no_mangle]
+pub unsafe extern "C" fn Java_dev_makepad_android_MakepadNative_onNotificationClicked(
+    env: *mut jni_sys::JNIEnv,
+    _: jni_sys::jclass,
+    id: jni_sys::jstring,
+) {
+    crate::cx::Cx::post_action(crate::notification::NotificationClicked {
+        id: jstring_lossy(env, id),
+    });
+}
+
+/// The permission: 0 not determined, 1 granted, 2 denied, 3 unavailable.
+#[no_mangle]
+pub unsafe extern "C" fn Java_dev_makepad_android_MakepadNative_onNotificationAuthorization(
+    env: *mut jni_sys::JNIEnv,
+    _: jni_sys::jclass,
+    status: jni_sys::jint,
+    requested: jni_sys::jboolean,
+    error: jni_sys::jstring,
+) {
+    use crate::notification::NotificationAuthorization as A;
+    let status = match status {
+        1 => A::Granted,
+        2 => A::Denied,
+        3 => A::Unavailable,
+        _ => A::NotDetermined,
+    };
+    let error = (!error.is_null()).then(|| jstring_lossy(env, error));
+    crate::cx::Cx::post_action(crate::notification::NotificationAuthorizationResult {
+        status,
+        requested: requested != 0,
+        error,
+    });
+}
