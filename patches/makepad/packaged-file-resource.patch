+    #[test]
+    fn a_packaged_build_still_reads_file_resource_from_its_absolute_path() {
+        use super::*;
+        // An app names a file it materialized at run time (an icon under its
+        // data dir) with file_resource(<absolute path>): no dependency path.
+        let dir = std::env::temp_dir().join(format!("makepad-file-resource-{}", std::process::id()));
+        std::fs::create_dir_all(&dir).unwrap();
+        let icon = dir.join("icon.svg");
+        let crate_icon = dir.join("crate-icon.svg");
+        std::fs::write(&icon, b"<svg/>").unwrap();
+        std::fs::write(&crate_icon, b"<svg crate/>").unwrap();
+        let (icon, crate_icon) = (icon.to_string_lossy().into_owned(), crate_icon.to_string_lossy().into_owned());
+        let mut cx = Cx::new(Box::new(|_, _| {}));
+        cx.package_root = Some("makepad".to_string());
+        let handle = ScriptHandle::ZERO;
+        for (heap, abs_path, dependency_path) in [(1, &icon, None), (2, &crate_icon, Some("demo/resources/crate-icon.svg"))] {
+            cx.script_data.resources.insert_resource(heap, CxScriptResource {
+                abs_path: abs_path.clone(), dependency_path: dependency_path.map(Into::into), web_url: None,
+                data: CxScriptResourceData::NotLoaded, handles: vec![(heap, handle)],
+            });
+        }
+        cx.load_script_resource_by_path(&icon);
+        cx.load_script_resource_by_path(&crate_icon);
+        assert_eq!(cx.get_resource(1, handle).unwrap().as_slice(), b"<svg/>", "file_resource reads its absolute path");
+        // A crate resource still loads only from the package once packaged:
+        // its build-tree path is not read even where it exists.
+        assert!(cx.get_resource(2, handle).is_none(), "a crate resource comes from the package");
+        assert!(cx.script_resource_unavailable(&crate_icon));
+        std::fs::remove_dir_all(&dir).ok();
+    }
+
