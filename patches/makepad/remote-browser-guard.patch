+    /// The bridge injects real input and serves the screen, so no web page
+    /// may reach it: a page could read `/snap` through a permissive CORS
+    /// header, or fire `/click` as an `<img>` GET without reading anything.
+    /// Every browser request carries an `Origin`, `Referer` or `Sec-Fetch-*`
+    /// header; the scripted clients this bridge is for (curl, urllib, the
+    /// harness) send none. A `Host` naming a domain other than `localhost` is
+    /// DNS rebinding (a fleet box is reached by IP, which stays allowed).
+    fn refused_head(head: &str) -> bool {
+        head.split("\r\n").skip(1).any(|line| {
+            let Some((name, value)) = line.split_once(':') else {
+                return false;
+            };
+            let name = name.trim().to_ascii_lowercase();
+            if name == "origin" || name == "referer" || name.starts_with("sec-fetch-") {
+                return true;
+            }
+            name == "host" && !host_is_local(value.trim())
+        })
+    }
+
+    fn host_is_local(host: &str) -> bool {
+        let name = match host.strip_prefix('[') {
+            Some(rest) => rest.split(']').next().unwrap_or(""),
+            None => host.rsplit_once(':').map(|(h, _)| h).unwrap_or(host),
+        };
+        name.eq_ignore_ascii_case("localhost") || name.parse::<std::net::IpAddr>().is_ok()
+    }
+
+    /// D10c: the per-launch secret every request carries as `X-Makepad-Token`.
+    static TOKEN: std::sync::OnceLock<String> = std::sync::OnceLock::new();
+
+    /// `MAKEPAD_REMOTE_TOKEN` when given (at run time, or baked in at build
+    /// time on phones, like the port); otherwise `mprt_` + 32 random bytes as hex.
+    fn launch_token() -> String {
+        #[cfg(any(target_env = "ohos", target_os = "android"))]
+        if let Some(v) = option_env!("MAKEPAD_REMOTE_TOKEN") {
+            if !v.trim().is_empty() {
+                return v.trim().to_string();
+            }
+        }
+        if let Ok(v) = std::env::var("MAKEPAD_REMOTE_TOKEN") {
+            if !v.trim().is_empty() {
+                return v.trim().to_string();
+            }
+        }
+        let mut bytes = [0u8; 32];
+        let urandom = std::fs::File::open("/dev/urandom").and_then(|mut f| f.read_exact(&mut bytes));
+        if urandom.is_err() {
+            // No /dev/urandom: RandomState is seeded from the OS generator.
+            use std::hash::{BuildHasher, Hasher};
+            let state = std::collections::hash_map::RandomState::new();
+            for (i, chunk) in bytes.chunks_mut(8).enumerate() {
+                let mut h = state.build_hasher();
+                h.write_usize(i);
+                h.write_u32(std::process::id());
+                chunk.copy_from_slice(&h.finish().to_le_bytes());
+            }
+        }
+        // The `mprt_` prefix lets a repository scan find a leaked token.
+        let hex: String = bytes.iter().map(|b| format!("{b:02x}")).collect();
+        format!("mprt_{hex}")
+    }
+
+    /// `<tmp>/makepad-remote/port-<PORT>.token`, directory 0700 and file 0600,
+    /// for the harness on the same machine and user to read.
+    fn write_token_file(port: u16, token: &str) -> Option<std::path::PathBuf> {
+        let dir = std::env::temp_dir().join("makepad-remote");
+        std::fs::create_dir_all(&dir).ok()?;
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::PermissionsExt;
+            let _ = std::fs::set_permissions(&dir, std::fs::Permissions::from_mode(0o700));
+        }
+        let path = dir.join(format!("port-{port}.token"));
+        let _ = std::fs::remove_file(&path);
+        let mut opts = std::fs::OpenOptions::new();
+        opts.write(true).create_new(true);
+        #[cfg(unix)]
+        {
+            use std::os::unix::fs::OpenOptionsExt;
+            opts.mode(0o600);
+        }
+        let mut file = opts.open(&path).ok()?;
+        file.write_all(token.as_bytes()).ok()?;
+        Some(path)
+    }
+
+    fn token_matches(head: &str, want: &str) -> bool {
+        head.split("\r\n").skip(1).any(|line| {
+            let Some((name, value)) = line.split_once(':') else {
+                return false;
+            };
+            name.trim().eq_ignore_ascii_case("x-makepad-token") && same_bytes(value.trim().as_bytes(), want.as_bytes())
+        })
+    }
+
+    /// Constant time in the bytes compared.
+    fn same_bytes(a: &[u8], b: &[u8]) -> bool {
+        a.len() == b.len() && a.iter().zip(b).fold(0u8, |acc, (x, y)| acc | (x ^ y)) == 0
+    }
+
+    #[cfg(test)]
+    mod browser_guard_tests {
+        use super::refused_head;
+
+        #[test]
+        fn scripted_clients_pass_and_browser_requests_are_refused() {
+            assert!(!refused_head("GET /snap HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nUser-Agent: curl/8.7\r\nAccept: */*"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: localhost:8400\r\nUser-Agent: Python-urllib/3.12"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: 10.0.0.5:8399"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: [::1]:8400"));
+            assert!(refused_head("GET /snap HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nOrigin: https://site.example"));
+            assert!(refused_head("GET /click?x=1&y=1 HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nSec-Fetch-Site: cross-site"));
+            assert!(refused_head("GET /click HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nReferer: https://site.example/"));
+            assert!(refused_head("GET /snap HTTP/1.1\r\nHost: rebound.site.example:8400"));
+        }
+
+        #[test]
+        fn only_the_launch_token_opens_the_bridge() {
+            use super::token_matches;
+            let head = |t: &str| format!("GET /s HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nX-Makepad-Token: {t}");
+            assert!(token_matches(&head("abc123"), "abc123"));
+            assert!(token_matches("GET /s HTTP/1.1\r\nx-makepad-token:  abc123 ", "abc123"));
+            assert!(!token_matches(&head("abc124"), "abc123"));
+            assert!(!token_matches(&head("abc12"), "abc123"));
+            assert!(!token_matches("GET /s HTTP/1.1\r\nHost: 127.0.0.1:8400", "abc123"));
+            assert!(!token_matches("GET /s?X-Makepad-Token: abc123 HTTP/1.1", "abc123"));
+        }
+    }
