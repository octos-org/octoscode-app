+
+    /// The bridge injects real input and serves the screen, so no web page
+    /// may reach it: a page could read `/snap` through a permissive CORS
+    /// header, or fire `/click` as an `<img>` GET without reading anything.
+    /// Every browser request carries an `Origin`, `Referer` or `Sec-Fetch-*`
+    /// header; the scripted clients this bridge is for (curl, urllib, the
+    /// harness) send none. A `Host` naming a domain other than `localhost` is
+    /// DNS rebinding (a fleet box is reached by IP, which stays allowed).
+    fn refused_head(head: &str) -> bool {
+        head.split("\r\n").skip(1).any(|line| {
+            let Some((name, value)) = line.split_once(':') else {
+                return false;
+            };
+            let name = name.trim().to_ascii_lowercase();
+            if name == "origin" || name == "referer" || name.starts_with("sec-fetch-") {
+                return true;
+            }
+            name == "host" && !host_is_local(value.trim())
+        })
+    }
+
+    fn host_is_local(host: &str) -> bool {
+        let name = match host.strip_prefix('[') {
+            Some(rest) => rest.split(']').next().unwrap_or(""),
+            None => host.rsplit_once(':').map(|(h, _)| h).unwrap_or(host),
+        };
+        name.eq_ignore_ascii_case("localhost") || name.parse::<std::net::IpAddr>().is_ok()
     }
 
+    #[cfg(test)]
+    mod browser_guard_tests {
+        use super::refused_head;
+
+        #[test]
+        fn scripted_clients_pass_and_browser_requests_are_refused() {
+            assert!(!refused_head("GET /snap HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nUser-Agent: curl/8.7\r\nAccept: */*"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: localhost:8400\r\nUser-Agent: Python-urllib/3.12"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: 10.0.0.5:8399"));
+            assert!(!refused_head("GET /s HTTP/1.1\r\nHost: [::1]:8400"));
+            assert!(refused_head("GET /snap HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nOrigin: https://site.example"));
+            assert!(refused_head("GET /click?x=1&y=1 HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nSec-Fetch-Site: cross-site"));
+            assert!(refused_head("GET /click HTTP/1.1\r\nHost: 127.0.0.1:8400\r\nReferer: https://site.example/"));
+            assert!(refused_head("GET /snap HTTP/1.1\r\nHost: rebound.site.example:8400"));
+        }
+    }
